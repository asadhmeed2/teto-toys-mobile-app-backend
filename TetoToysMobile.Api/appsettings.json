{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CorsOrigins": "http://localhost:4200",
  "Store": {
    "TimeZone": "Asia/Jerusalem"
  },
  "Jwt": {
    "AccessTokenTtl": "00:15:00",
    "RefreshTokenTtl": "30.00:00:00"
  },
  "RateLimit": {
    "Enabled": true,
    "ServiceName": "mobile",
    "GlobalLimit": 120,
    "GlobalWindowSeconds": 60,
    "GlobalBurst": 120,
    "AuthLimit": 10,
    "AuthWindowSeconds": 60,
    "AuthBurst": 10,
    "StrictPathPrefixes": [ "/api/auth" ],
    "TrustForwardedHeaders": false
  },
  "Redis": {
    "Host": "127.0.0.1",
    "Port": "6379",
    "Password": ""
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=TetoToys;Uid=TetoToys;Pwd=YourSqlPassword123!;"
  }
}
